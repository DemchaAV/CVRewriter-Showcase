# ============================================================================
# CVRewriter — sanitized environment variable reference
# ============================================================================
# This file documents the full configuration surface of the real project.
# All values here are placeholders. The real .env.* files are NOT included
# in this showcase repository — see docs/security-and-privacy.md.
#
# The production project uses three separate env files (one per environment):
#   .env.prod  → "production-like" stack (default ports 3000/8080/3307)
#   .env.dev   → "development"     stack (default ports 3002/8082/3309)
#   .env.test  → "QA / integration" stack (default ports 3001/8081/3308)
# ============================================================================


# ----------------------------------------------------------------------------
# Spring profile + Docker stack identity
# ----------------------------------------------------------------------------

SPRING_PROFILES_ACTIVE=dev               # dev | test | prod
NODE_ENV=development                     # development | production


# ----------------------------------------------------------------------------
# Network ports (host-side; container-side is fixed inside Compose)
# ----------------------------------------------------------------------------

FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3307


# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------

# Leave empty in Docker (Nginx proxies /api). Set for local frontend-only dev.
VITE_API_URL=

# Origin used when the backend needs to construct outbound URLs (verification
# links, billing redirects, etc.)
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated list. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ----------------------------------------------------------------------------
# Database (MySQL 8)
# ----------------------------------------------------------------------------

MYSQL_DATABASE=cv_rewriter
MYSQL_ROOT_PASSWORD=replace_with_strong_password
DB_USERNAME=root
DB_PASSWORD=replace_with_strong_password

# Where the backend keeps its per-environment data directory (mounted as a volume).
BACKEND_DATA_DIR=./backend/data


# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------

# Base64-encoded HMAC secret for JWT signing. Use a long random value (>= 32 bytes).
JWT_SECRET=replace_with_long_random_secret

# Token lifetimes (milliseconds).
JWT_EXPIRATION=86400000                  # 24h access token
JWT_REFRESH_EXPIRATION=604800000         # 7d refresh token
JWT_SSE_EXPIRATION=120000                # 120s SSE-scoped token

# At-rest encryption key for the JPA EncryptionConverter (AES/GCM).
# Must be at least 16 characters.
ENCRYPTION_KEY=replace_with_16_plus_chars

# Admin break-glass: callers presenting this header can hit /admin/** without a JWT.
ADMIN_SECRET_KEY=replace_with_admin_key


# ----------------------------------------------------------------------------
# AI providers
# ----------------------------------------------------------------------------

# Active provider at boot. Mutable at runtime via PUT /admin/ai-settings.
AI_PROVIDER=gemini                       # gemini | gpt | deepseek

# Provider API keys — supply only the ones you intend to use.
GEMINI_API=YOUR_GEMINI_API_KEY_HERE
GPT_API=YOUR_OPENAI_API_KEY_HERE
DEEP_SEEK_API=YOUR_DEEPSEEK_API_KEY_HERE

# Where to load prompts from (external mount). Falls back to classpath if absent.
BACKEND_PROMPTS_DIR=./backend/prompts


# ----------------------------------------------------------------------------
# Scraping / Playwright
# ----------------------------------------------------------------------------

# true in prod-like containers, false during local browser-visible debugging.
PLAYWRIGHT_HEADLESS=true


# ----------------------------------------------------------------------------
# Email (SMTP) — verification, password reset
# ----------------------------------------------------------------------------

# Use Mailpit locally (./scripts/mailpit), real SMTP in prod.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
EMAIL_FROM_ADDRESS=no-reply@example.com

# Mailpit web UI port (dev/test only).
MAILPIT_UI_PORT=8025

EMAIL_VERIFICATION_TTL_MINUTES=1440      # 24h


# ----------------------------------------------------------------------------
# Billing (Stripe)
# ----------------------------------------------------------------------------

# Feature flag — when false, billing endpoints return 501 and entitlements default to FREE.
STRIPE_ENABLED=false

# Stripe API. Override only if you mock Stripe in tests.
STRIPE_API_BASE_URL=https://api.stripe.com/v1

# Server-side keys — NEVER commit real values.
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# The Stripe Price ID for the PRO subscription plan.
STRIPE_PRO_PRICE_ID=price_REPLACE_ME

# Where Stripe Checkout sends the user back. Use your frontend URL.
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/profile/settings?billing=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/profile/settings?billing=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/profile/settings


# ----------------------------------------------------------------------------
# External integrations (sanitized)
# ----------------------------------------------------------------------------
#
# The real project supports connecting external accounts (e.g. for scraping
# gated job boards). In production these credentials are stored encrypted
# at rest via the EncryptionConverter — never read directly from this file
# in a long-running deployment.
#
# Example shape (DO NOT commit real values):
#
# EXTERNAL_PROVIDER_USERNAME=your_account_email
# EXTERNAL_PROVIDER_PASSWORD=your_account_password
# EXTERNAL_PROVIDER_SESSION_FILE=/app/data/example-session.json
#
# In this showcase repo we deliberately do not name the specific provider
# the production project integrates with — that's an implementation detail
# of the real deployment.
